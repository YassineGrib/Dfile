rules_version = '2';

// ===============================================================
// Assumed Data Model for FinTask
// All collections below live under users/{uid}/ and are private to that user.
// ===============================================================
//
// Collection: clients
// Document ID: auto / cli_*
// Fields:
//   - id: string (required)
//   - name: string (required, 1-100 chars)
//   - email: string (optional, valid email format)
//   - phone: string (optional)
//   - address: string (optional)
//   - notes: string (optional)
//   - social_links: map (optional)
//   - created_at: string (required)
//   - updated_at: string (optional)
//
// Collection: projects
// Document ID: auto / proj_*
// Fields:
//   - id: string (required)
//   - name: string (required, 1-150 chars)
//   - description: string (optional)
//   - category: string (required)
//   - client_id: string (required)
//   - price_dzd: number (required, >= 0)
//   - status: string (required, enum: 'Planned' | 'In Progress' | 'Waiting Client' | 'Completed' | 'Cancelled')
//   - progress_percentage: number (required, 0-100)
//   - start_date: string (optional)
//   - end_date: string (optional)
//   - created_at: string (required)
//
// Collection: expenses
// Document ID: auto / exp_*
// Fields:
//   - id: string (required)
//   - amount: number (required, >= 0)
//   - category: string (required)
//   - description: string (optional)
//   - project_id: string (optional)
//   - expense_date: string (required)
//   - created_at: string (required)
//
// Collection: invoices
// Document ID: auto / inv_*
// Fields:
//   - id: string (required)
//   - invoice_number: string (required)
//   - invoice_type: string (required, 'proforma' | 'final')
//   - client_id: string (required)
//   - project_id: string (required)
//   - invoice_date: string (required)
//   - total_amount: number (required, >= 0)
//   - payment_method: string (required)
//   - status: string (required, 'draft' | 'sent' | 'paid' | 'overdue')
//   - line_items: list (required)
//   - created_at: string (required)
//
// Collection: tasks
// Document ID: auto / tsk_*
// Fields:
//   - id: string (required)
//   - project_id: string (required)
//   - name: string (required, 1-200 chars)
//   - status: string (required, 'Next up' | 'In Progress' | 'Complete')
//   - due_date: string (optional)
//   - labels: list (optional)
//   - assignees: list (optional)
//   - comments: list (optional)
//   - created_at: string (required)
//
// Collection: payments
// Document ID: auto / pay_*
// Fields:
//   - id: string (required)
//   - project_id: string (required)
//   - client_id: string (required)
//   - amount: number (required, >= 0)
//   - payment_type: string (required)
//   - payment_method: string (required)
//   - payment_date: string (required)
//   - created_at: string (required)
//
// Collection: activities
// Document ID: auto / act_*
// Fields:
//   - id: string (required)
//   - text: string (required)
//   - text_ar: string (required)
//   - type: string (required, 'project' | 'payment' | 'expense' | 'client')
//   - timestamp: string (required)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidClient(data) {
      return hasRequiredFields(['id', 'name', 'created_at']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    function isValidProject(data) {
      return hasRequiredFields(['id', 'name', 'category', 'client_id', 'price_dzd', 'status', 'progress_percentage']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.price_dzd is number && data.price_dzd >= 0 &&
             data.progress_percentage is number && data.progress_percentage >= 0 && data.progress_percentage <= 100 &&
             data.status in ['Planned', 'In Progress', 'Waiting Client', 'Completed', 'Delivered', 'Cancelled'];
    }

    function isValidExpense(data) {
      return hasRequiredFields(['id', 'amount', 'category', 'expense_date']) &&
             data.amount is number && data.amount >= 0 &&
             data.category is string && data.category.size() <= 80;
    }

    function isValidInvoice(data) {
      return hasRequiredFields(['id', 'invoice_number', 'invoice_type', 'client_id', 'total_amount', 'status']) &&
             data.total_amount is number && data.total_amount >= 0 &&
             data.invoice_type in ['proforma', 'final'] &&
             data.status in ['draft', 'sent', 'paid', 'overdue'];
    }

    function isValidTask(data) {
      return hasRequiredFields(['id', 'project_id', 'name', 'status']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.status in ['Next up', 'In Progress', 'Complete'];
    }

    function isValidPayment(data) {
      return hasRequiredFields(['id', 'project_id', 'client_id', 'amount']) &&
             data.amount is number && data.amount >= 0;
    }

    function isValidActivity(data) {
      return hasRequiredFields(['id', 'text', 'type']) &&
             data.type in ['project', 'payment', 'expense', 'client'];
    }

    // The PIN may only be stored hashed — never as plain text
    function hasNoPlainPin(data) {
      return !('security' in data) || !('pin_code' in data.security);
    }

    // ===============================================================
    // Private per-user workspace: users/{uid}/...
    // Only the signed-in owner can read or write anything in here.
    // ===============================================================
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /clients/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidClient(request.resource.data);
      }

      match /projects/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidProject(request.resource.data);
      }

      match /expenses/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidExpense(request.resource.data);
      }

      match /invoices/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidInvoice(request.resource.data);
      }

      match /tasks/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTask(request.resource.data);
      }

      match /payments/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidPayment(request.resource.data);
      }

      match /activities/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidActivity(request.resource.data);
      }

      match /milestones/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasRequiredFields(['id', 'project_id', 'title', 'date']);
      }

      match /contracts/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasRequiredFields(['id', 'title', 'project_id']);
      }

      match /settings/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasNoPlainPin(request.resource.data);
      }

      match /support_tickets/{id} {
        allow read, write: if isOwner(userId);
      }

      match /friends/{id} {
        allow read, write: if isOwner(userId);
      }

      match /friend_transactions/{id} {
        allow read, write: if isOwner(userId);
      }

      match /friend_settlements/{id} {
        allow read, write: if isOwner(userId);
      }
    }

    // ===============================================================
    // Legacy shared data (before workspaces were private)
    // The first account to write the claim owns it; only that account
    // can then read the old collections to import them. Nobody can write them.
    // ===============================================================
    function claimPath() {
      return /databases/$(database)/documents/legacy_migration/claim;
    }

    function isLegacyOwner() {
      return isAuthenticated() && exists(claimPath()) && get(claimPath()).data.uid == request.auth.uid;
    }

    match /legacy_migration/claim {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
    }

    match /{legacyCollection}/{docId} {
      allow read: if legacyCollection in ['clients', 'projects', 'expenses', 'invoices', 'tasks', 'payments',
                                          'activities', 'milestones', 'contracts', 'settings',
                                          'friends', 'friend_transactions', 'friend_settlements']
                  && isLegacyOwner();
    }

    // Default deny for anything not explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }
  }
}